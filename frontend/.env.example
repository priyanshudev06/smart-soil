# Frontend Environment Variables (Example)
# Copy this file to .env.local for local development. Do NOT commit real secrets.

# Backend API endpoint URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application environment (development | production)
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_WEB_BLUETOOTH=true
VITE_ENABLE_MOCK_DEVICE=true
VITE_ENABLE_OFFLINE_MODE=true

# Supported Languages (Comma-separated: mr=Marathi, hi=Hindi, en=English)
VITE_SUPPORTED_LANGUAGES=mr,hi,en
VITE_DEFAULT_LANGUAGE=mr
