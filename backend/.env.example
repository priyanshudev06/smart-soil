# Backend Environment Configuration (Example)
# Copy to .env for local development. NEVER commit real production secrets to version control.

# Database URL (SQLite for local prototype, PostgreSQL for production)
DATABASE_URL=sqlite:///./smart_soil.db

# Security & Authentication
JWT_SECRET=replace-with-a-very-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173

# Server Host & Port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# External Integrations (To be filled during Phase 3 & 4)
WEATHER_API_KEY=
MARKET_DATA_API_KEY=
LLM_API_KEY=
